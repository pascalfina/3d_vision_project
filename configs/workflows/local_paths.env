# Local path overrides for Object-X workflow profiles.
# This file is ignored by git by default. Commit it only if the team wants to
# share these exact paths.

# Personal scratch root and shared team root.
export OBJECTX_USER_ROOT="/work/scratch/${USER}"
export OBJECTX_TEAM_ROOT="/work/courses/3dv/team35/${USER}"

# Prepared read-only input dataset.
export OBJECTX_BASELINE_ROOT="${OBJECTX_USER_ROOT}/objectx-data-baseline"

# Shared place for heavy generated outputs and long logs.
export OBJECTX_WORKFLOW_LOG_ROOT="${OBJECTX_TEAM_ROOT}/logs"
export OBJECTX_CABINET_RECON_ROOT="${OBJECTX_TEAM_ROOT}/objectx-data-fullscene-cabinet-hybrid-gtmask"

# Final pred-ready dataset consumed by SLAT/U3DGS.
export OBJECTX_CABINET_PREDREADY_FLOORFIX_ROOT="${OBJECTX_USER_ROOT}/objectx-data-fullscene-cabinet-predready-v2-floorfix"
