# Local path overrides for Object-X workflow profiles.
# The workflow runner loads this automatically and expands ${...} in profile JSON.

# Base storage roots.
# OBJECTX_USER_ROOT: personal scratch space for input data and lighter outputs.
# OBJECTX_TEAM_ROOT: shared course/team storage for heavier shared outputs.
export OBJECTX_USER_ROOT="/work/scratch/${USER}"
export OBJECTX_TEAM_ROOT="/work/courses/3dv/team35/${USER}"

# Repo-local output roots.
# These are derived from the checked-out repository location by default.
export OBJECTX_REPO_DEBUG_ROOT="${OBJECTX_REPO_ROOT}/debug"
export OBJECTX_REPO_VIS_ROOT="${OBJECTX_REPO_ROOT}/vis"

# Prepared read-only input dataset used by segment-inputs, must3r, voxelise,
# validation, and render whenever they need original RGB/depth/metadata.
export OBJECTX_BASELINE_ROOT="${OBJECTX_USER_ROOT}/objectx-data-baseline"

# Shared place for long workflow logs.
export OBJECTX_WORKFLOW_LOG_ROOT="${OBJECTX_TEAM_ROOT}/logs"

# Cabinet SAM2-only outputs.
# Used by segment-inputs, voxelise, build-pred-ready, slat/u3dgs, render.
export OBJECTX_CABINET_SAM2_RECON_ROOT="${OBJECTX_USER_ROOT}/objectx-data-fullscene-cabinet-hybrid-sam2mask"
export OBJECTX_CABINET_SAM2_PREDREADY_ROOT="${OBJECTX_USER_ROOT}/objectx-data-fullscene-cabinet-predready-sam2-v1"

# Cabinet SAM2 + MUSt3R outputs.
# OBJECTX_CABINET_RECON_ROOT is the shared reconstruction root containing
# sam2_projection masks and scenes_sam2_must3r.
export OBJECTX_CABINET_RECON_ROOT="${OBJECTX_TEAM_ROOT}/objectx-data-fullscene-cabinet-hybrid-gtmask"
export OBJECTX_CABINET_MUST3R_PREDREADY_ROOT="${OBJECTX_USER_ROOT}/objectx-data-fullscene-cabinet-predready-sam2-must3r-v1"
export OBJECTX_CABINET_PREDREADY_FLOORFIX_ROOT="${OBJECTX_USER_ROOT}/objectx-data-fullscene-cabinet-predready-v2-floorfix"

# Cabinet MASt3R-SfM outputs and cache.
export OBJECTX_CABINET_MAST3R_SFM_RECON_ROOT="${OBJECTX_USER_ROOT}/objectx-data-fullscene-cabinet-hybrid-sam2mask-mast3r-sfm"
export OBJECTX_CABINET_MAST3R_SFM_PREDREADY_ROOT="${OBJECTX_USER_ROOT}/objectx-data-fullscene-cabinet-predready-sam2-mast3r-sfm-v1"
export OBJECTX_CABINET_MAST3R_SFM_MUST3R_PREDREADY_ROOT="${OBJECTX_TEAM_ROOT}/objectx-data/objectx-data-fullscene-cabinet-predready-sam2-mast3r-sfm-must3r-v1"
export OBJECTX_MAST3R_SFM_CACHE_DIR="${OBJECTX_TEAM_ROOT}/objectx-cache/mast3r_sfm_cabinet"

# Cabinet lifted-only baseline/GT-pose debug profile.
export OBJECTX_CABINET_LIFTED_RECON_ROOT="${OBJECTX_USER_ROOT}/objectx-data-fullscene-cabinet-lifted-gtmask"
export OBJECTX_CABINET_LIFTED_PREDREADY_ROOT="${OBJECTX_USER_ROOT}/objectx-data-fullscene-cabinet-predready-v2-liftedonly"

# Oven profile outputs.
export OBJECTX_OVEN_RECON_ROOT="${OBJECTX_USER_ROOT}/objectx-data-fullscene-oven-hybrid-gtmask"
export OBJECTX_OVEN_PREDREADY_ROOT="${OBJECTX_USER_ROOT}/objectx-data-fullscene-oven-predready-v1"
