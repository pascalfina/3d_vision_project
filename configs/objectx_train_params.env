# Object-X training/inference parameter overrides.
# Leave a value empty ("") to keep the YAML default.
# These are converted by ./run.sh into command-line config overrides.

# Quick test default: stop after 10 epochs.
TRAIN_MAX_EPOCH="10"

# Common runtime controls
TRAIN_BATCH_SIZE=""
VAL_BATCH_SIZE=""
TRAIN_NUM_WORKERS=""
VAL_NUM_WORKERS=""
TRAIN_LR=""
TRAIN_CLIP_GRAD=""

# Logging / validation cadence
TRAIN_LOG_STEPS=""
TRAIN_SNAPSHOT_STEPS=""
TRAIN_VISUALIZE_STEPS=""
TRAIN_VAL_STEPS=""

# Boolean-style overrides; use "true" / "false" or leave empty
TRAIN_FREEZE_ENCODER=""
TRAIN_DECODER=""

# Extra raw overrides for anything not covered above, for example:
# PARAM_RUN_ARGS=(
#   "autoencoder.encoder.voxel.channels=[16,32,64]"
#   "train.loss.decoder_weight=0.5"
# )
PARAM_RUN_ARGS=()
