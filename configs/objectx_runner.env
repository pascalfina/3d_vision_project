# Object-X runner config

REPO_DIR="/work/scratch/pafina/object-x"
DATA_ROOT_DIR="/work/scratch/pafina/objectx-data"
SCRATCH="/work/scratch/pafina"
PARAMS_FILE="configs/objectx_train_params.env"

# local | sbatch
LAUNCH_MODE="local"

# check_env | train_latent_autoencoder | train_reconstruction | train_scene_graph_loc
# inference_slat | inference_u3dgs
# voxelise_features | voxelise_features_scannet | voxelise_features_scene_alignment
# annotate_gaussians | annotate_gaussians_scannet | map_to_colmap | map_to_colmap_scannet
# custom
ACTION="check_env"

# Only used when ACTION="custom"
CUSTOM_SCRIPT=""

# Additional arguments passed to the selected script
RUN_ARGS=()

# Slurm defaults used when LAUNCH_MODE="sbatch"
SBATCH_ACCOUNT="3dv"
SBATCH_QOS="3dv-team35"
SBATCH_PARTITION="jobs"
SBATCH_TIME="24:00:00"
SBATCH_GPUS="1"
SBATCH_CPUS="2"
SBATCH_MEM="24G"
SBATCH_JOB_NAME="objectx"
SBATCH_OUTPUT="slurm-%x-%j.out"
